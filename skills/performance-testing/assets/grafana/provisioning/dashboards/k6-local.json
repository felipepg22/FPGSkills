{
  "annotations": { "list": [] },
  "description": "For the complete latency panels, run k6 remote write with K6_PROMETHEUS_RW_TREND_STATS=avg,p(50),p(95),p(99). Tag runs with testid=<run-id> to filter them; untagged series remain visible under All.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "performance-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "HTTP requests/s", "refId": "A" },
        { "expr": "sum(rate(k6_operation_requests_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "Operations/s", "refId": "B" }
      ],
      "title": "Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "performance-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "(sum(rate(k6_http_reqs_total{testid=~\"$testid\",expected_response=\"false\"}[$__rate_interval])) or on() vector(0)) / clamp_min((sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval])) or on() vector(0)), 1e-9)",
          "legendFormat": "HTTP error rate",
          "refId": "A"
        },
        { "expr": "k6_operation_failed_rate{testid=~\"$testid\"}", "legendFormat": "{{operation}} {{scenario}} {{rpc_type}}", "refId": "B" }
      ],
      "title": "Error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "performance-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "k6_http_req_duration_p50{testid=~\"$testid\"}", "legendFormat": "p50 {{scenario}} {{name}} {{method}} {{status}}", "refId": "A" },
        { "expr": "k6_http_req_duration_p95{testid=~\"$testid\"}", "legendFormat": "p95 {{scenario}} {{name}} {{method}} {{status}}", "refId": "B" },
        { "expr": "k6_http_req_duration_p99{testid=~\"$testid\"}", "legendFormat": "p99 {{scenario}} {{name}} {{method}} {{status}}", "refId": "C" },
        { "expr": "k6_http_req_duration_avg{testid=~\"$testid\"}", "legendFormat": "mean {{scenario}} {{name}} {{method}} {{status}}", "refId": "D" }
      ],
      "description": "Each line is one k6 tag set. Percentile gauges are intentionally not averaged because separate percentile distributions cannot be combined mathematically.",
      "title": "HTTP response time by tag set",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "performance-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "{__name__=~\"k6_grpc_.*_(avg|med|p50|p95|p99)\",testid=~\"$testid\"}", "legendFormat": "{{__name__}} {{operation}} {{scenario}} {{rpc_type}}", "refId": "A" }
      ],
      "description": "Each line is one k6 tag set; percentile gauges remain separate.",
      "title": "gRPC timing by tag set",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["k6", "local", "performance-testing"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "performance-prometheus" },
        "definition": "label_values(k6_iterations_total, testid)",
        "includeAll": true,
        "label": "Test run",
        "multi": true,
        "name": "testid",
        "query": { "query": "label_values(k6_iterations_total, testid)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Local k6 Performance Tests",
  "uid": "local-k6-performance-tests",
  "version": 1
}
